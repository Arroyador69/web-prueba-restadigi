# Variables de entorno – Vercel / local

# Obligatorio en Vercel
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
SESSION_SECRET=cambia-esto-por-un-secreto-largo
DEMO_ADMIN_SECRET=clave-para-panel-demos
CRON_SECRET=clave-para-cron-jobs

# URL pública (enlaces de demos)
APP_URL=https://tu-proyecto.vercel.app

# Home redirige a /demos (panel ventas)
MULTI_TENANT_HOME=demos

NODE_ENV=production

# Email – Resend recomendado en Vercel
RESEND_API_KEY=
EMAIL_FROM=Reservas <onboarding@resend.dev>

# O SMTP clásico
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Opcional
# BUSINESS_NAME=
# BUSINESS_PHONE=
# BUSINESS_EMAIL=
# RESET_PASSWORD_SECRET=
