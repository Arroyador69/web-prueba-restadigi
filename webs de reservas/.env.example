# Variables de entorno – Vercel / local

# Obligatorio en Vercel
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
SESSION_SECRET=cambia-esto-por-un-secreto-largo
DEMO_ADMIN_SECRET=clave-para-panel-demos
CRON_SECRET=clave-para-cron-jobs

# URL pública
APP_URL=https://web-prueba-restadigi.vercel.app

# Demo pública sin login (landing + dashboard abiertos)
PUBLIC_DEMO=true

# Home: con PUBLIC_DEMO=true la home es la landing (ignora demos)
# MULTI_TENANT_HOME=demos

NODE_ENV=production

# Chatbot (opcional). Sin clave usa flujo guiado por reglas.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Email – desactivado en PUBLIC_DEMO
RESEND_API_KEY=
EMAIL_FROM=Reservas <onboarding@resend.dev>
