{
  "name": "plantilla-reservas-psicologo",
  "version": "1.1.0",
  "description": "Sistema multi-tenant de reservas de citas para psicólogos (Vercel + Postgres)",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "build": "node -e \"console.log('build ok')\"",
    "dev": "nodemon scripts/start.js",
    "init-db": "node -e \"require('./database/init-pg').initPostgres().then(()=>process.exit(0))\""
  },
  "keywords": [
    "reservas",
    "citas",
    "psicologo",
    "saas",
    "multitenant",
    "vercel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "connect-pg-simple": "^10.0.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "googleapis": "^144.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.15.2",
    "pg": "^8.18.0"
  },
  "optionalDependencies": {
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
